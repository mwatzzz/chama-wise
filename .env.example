# Use development only for local XAMPP; production needs explicit DB credentials and a dedicated DB user.
APP_ENV=development
# Set the HTTPS origin (without a path) for production HTTP-to-HTTPS redirects.
APP_URL=
# Enable only when the application is reachable exclusively through a trusted TLS-terminating proxy.
TRUST_PROXY_HTTPS=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chama_ai_management_system
DB_USER=root
DB_PASS=

APP_NAME=ChamaWise
APP_BASE=/chama-wise
SESSION_NAME=chamawise_session
SESSION_IDLE_TIMEOUT=900
CONTRIBUTION_DUE_DAY=5
LATE_CONTRIBUTION_PENALTY=100
LATE_LOAN_PENALTY_PERCENT=5
LOAN_MIN_MEMBERSHIP_MONTHS=3
LOAN_MIN_CONTRIBUTIONS=3
LOAN_MIN_TOTAL_CONTRIBUTIONS=5000
LOAN_MAX_MULTIPLE=2
LOAN_MAX_AMOUNT=100000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=90
OLLAMA_NUM_PREDICT=256
# App-enforced maximum questions per member per UTC day; configure provider billing limits separately.
AI_MEMBER_DAILY_LIMIT=20
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=ChamaWise
SMS_PROVIDER=log
AFRICASTALKING_ENV=production
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Daraja Sandbox only. Never add these credentials to source control.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
# Public HTTPS URL that Safaricom Sandbox can reach:
DARAJA_CALLBACK_URL=
# MobileSasa SMS provider settings (used when SMS_PROVIDER=mobilesasa)
# Minimum mbs_ token scopes: team:messages:send; add team:messages:view for DLR lookup;
# add team:lookup:use only if authorized hashed-MSISDN resolution is enabled.
MOBILESASA_API_TOKEN=
MOBILESASA_SENDER_ID=
MOBILESASA_WEBHOOK_SECRET=
MOBILESASA_TRIAL_MODE=true
MOBILESASA_TRIAL_PHONE=
